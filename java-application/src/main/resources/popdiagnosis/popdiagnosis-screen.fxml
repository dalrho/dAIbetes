<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="popdiagnosis.Popdiagnosiscontroller"
           style="-fx-background-color: rgba(0,0,0,0.3);">

    <!-- SMALL CENTERED CARD -->
    <VBox spacing="12"
          alignment="CENTER"
          maxWidth="450"
          maxHeight="450"
          style="-fx-background-color: white;
                 -fx-background-radius: 15;
                 -fx-padding: 20;">

        <!-- TITLE -->
        <Label text="Start New Diagnosis"
               style="-fx-font-size: 24px;
                      -fx-font-weight: bold;"/>

        <!-- DESCRIPTION -->
        <Label text="Select an option below to upload or capture an image for analysis."
               wrapText="true"
               style="-fx-font-size: 12px;
                      -fx-text-fill: gray;
                      -fx-text-alignment: center;"/>

        <Label text="Upload up to 3 images for analysis"
               style="-fx-font-size: 12px;
                      -fx-text-fill: gray;"/>



        <!-- UPLOAD -->
        <Button fx:id="uploadImageBtn"
                text="Upload Images"
                onAction="#onUploadImage"
                prefWidth="260"
                style="-fx-background-color: black;
                       -fx-text-fill: white;
                       -fx-background-radius: 10;
                       -fx-padding: 8 18;"/>

        <Label text="or"
               style="-fx-font-size: 11px;
                      -fx-text-fill: gray;"/>

        <!-- CAMERA -->
        <Button fx:id="openCameraBtn"
                text="Open Camera"
                onAction="#onOpenCamera"
                prefWidth="260"
                style="-fx-background-color: #3B82F6;
               -fx-text-fill: white;
               -fx-background-radius: 10;
               -fx-padding: 8 18; -fx-cursor: hand;"/>



        <!-- CLOSE -->
        <Button fx:id="closeBtn"
                text="Close"
                onAction="#onClose"
                prefWidth="110"
                style="-fx-background-color: red;
                       -fx-text-fill: white;
                       -fx-background-radius: 10;"/>
    </VBox>

</StackPane>