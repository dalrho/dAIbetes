<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="recordsPatient.RecordsPatientController"
            style="-fx-font-family: 'Segoe UI', 'Roboto', sans-serif; -fx-background-color: #F9FAFB;">

    <!-- TOP: Simplified Header -->
    <top>
        <VBox spacing="0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E8EEF5; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="24" right="32" bottom="24" left="32"/>
            </padding>

            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="My Health Records"
                           style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1A2332;"/>
                    <Label text="View your past scans and diagnostic reports"
                           style="-fx-font-size: 12; -fx-text-fill: #6B7280; -fx-font-style: italic;"/>
                </VBox>

                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button text="Back to Home" onAction="#handleBack"
                            style="-fx-font-size: 11; -fx-padding: 10 18; -fx-background-color: #F3F4F6; -fx-text-fill: #374151; -fx-border-color: #D1D5DB; -fx-border-width: 1; -fx-border-radius: 6;"/>

                    <Button text="⟳ Refresh" onAction="#handleRefresh"
                            style="-fx-font-size: 11; -fx-padding: 10 18; -fx-background-color: #F3F4F6; -fx-text-fill: #374151; -fx-border-color: #D1D5DB; -fx-border-width: 1; -fx-border-radius: 6;"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER -->
    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="24" right="32" bottom="32" left="32"/>
            </padding>

            <!-- SEARCH & FILTER (Removed Patient ID search as user only sees their own) -->
            <HBox spacing="20" alignment="CENTER_LEFT"
                  style="-fx-background-color: FFFFFF; -fx-padding: 16; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-color: #E8EEF5; -fx-border-width: 1;">

                <VBox spacing="6">
                    <Label text="Filter by Date" style="-fx-font-size: 11; -fx-text-fill: #6B7280; -fx-font-weight: bold;"/>
                    <DatePicker fx:id="datePicker" promptText="Select date..."/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Diagnosis Status" style="-fx-font-size: 11; -fx-text-fill: #6B7280; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="statusFilter" prefWidth="180" promptText="All Results"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Clear Filters" onAction="#handleClearFilters"
                        style="-fx-background-color: transparent; -fx-text-fill: #6B7280; -fx-font-size: 11;"/>
            </HBox>

            <!-- TABLE: Patient Specific -->
            <VBox spacing="12" VBox.vgrow="ALWAYS">
                <Label text="Recent Scans" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1A2332;"/>

                <TableView fx:id="patientRecordsTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8; -fx-overflow-x: hidden;">
                    <columns>
                        <TableColumn fx:id="colDate" text="Date of Scan" prefWidth="180"/>
                        <TableColumn fx:id="colType" text="Scan Type" prefWidth="150"/>
                        <TableColumn fx:id="colDiagnosis" text="Primary Diagnosis" prefWidth="250"/>
                        <TableColumn fx:id="colCriticality" text="Criticality" prefWidth="150"/>
                        <TableColumn fx:id="colActions" text="Options" prefWidth="180"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="10">
                            <Label text="No records found." style="-fx-text-fill: #9CA3AF;"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <!-- BOTTOM -->
    <bottom>
        <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-background-color: #FFFFFF; -fx-border-color: #E8EEF5; -fx-border-width: 1 0 0 0; -fx-padding: 12 32;">
            <Label text="dAIbetes" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Last sync with clinic:" style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;"/>
            <Label fx:id="lblLastUpdated" text="Today at 10:30 AM" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #6B7280;"/>
        </HBox>
    </bottom>

</BorderPane>