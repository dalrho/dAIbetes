<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="patientsdashboard.PatientDashboardController"
        prefHeight="860.0"
        prefWidth="1366.0"
        style="-fx-background-color: #EBEBEB;">

    <left>
        <VBox prefWidth="260.0" minWidth="260.0" maxWidth="260.0" style="-fx-background-color: #F2F2F2;">
            <VBox>
                <padding><Insets top="28" right="20" bottom="20" left="20"/></padding>
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <StackPane minWidth="74" minHeight="74" maxWidth="74" maxHeight="74">
                        <Circle radius="37" style="-fx-fill: #C8C8C8; -fx-stroke: #ADADAD; -fx-stroke-width: 1.5;"/>
                        <ImageView fx:id="profileImage" fitWidth="60" fitHeight="60" preserveRatio="true" smooth="true"/>
                    </StackPane>
                    <VBox spacing="1">
                        <Label text="Good morning," style="-fx-font-size: 13px; -fx-text-fill: #888888;"/>
                        <Label fx:id="patientNameLabel" text="Patient Name" style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #111111;"/>
                        <Label fx:id="patientIdLabel" text="ID: 12345" style="-fx-font-size: 13px; -fx-text-fill: #666666;"/>
                    </VBox>
                </HBox>
            </VBox>

            <VBox>
                <padding><Insets top="18" right="20" bottom="10" left="20"/></padding>
                <Label text="What would you like to" style="-fx-font-size: 14px; -fx-text-fill: #555555;"/>
                <Label text="do today?" style="-fx-font-size: 14px; -fx-text-fill: #555555;"/>
            </VBox>

            <VBox spacing="12">
                <padding><Insets top="6" right="20" bottom="0" left="20"/></padding>
                <Button fx:id="viewDiagnosisBtn" text="View Records" maxWidth="Infinity" onAction="#onViewDiagnosis"
                        style="-fx-background-color: #1A1A1A; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 14 20; -fx-background-radius: 7; -fx-cursor: hand;"/>
                <Button fx:id="scheduleFollowUpBtn" text="Schedule Follow-up" maxWidth="Infinity" onAction="#onScheduleFollowUp"
                        style="-fx-background-color: #1A1A1A; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 14 20; -fx-background-radius: 7; -fx-cursor: hand;"/>
                <Button fx:id="myDoctorsBtn" text="My Doctors" maxWidth="Infinity" onAction="#onMyDoctors"
                        style="-fx-background-color: #1A1A1A; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 14 20; -fx-background-radius: 7; -fx-cursor: hand;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox>
                <padding><Insets top="0" right="20" bottom="24" left="20"/></padding>
                <TextFlow>
                    <Text text="d" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-fill: #111111;"/>
                    <Text text="AI" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-fill: #999999;"/>
                    <Text text="betes" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-fill: #111111;"/>
                </TextFlow>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox style="-fx-background-color: #EBEBEB;">
            <HBox alignment="CENTER_RIGHT">
                <padding><Insets top="16" right="24" bottom="0" left="24"/></padding>
                <Button fx:id="logoutBtn" text="Log out" onAction="#onLogout"
                        style="-fx-background-color: #C0392B; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </HBox>

            <Label text="Dashboard" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #111111;">
                <VBox.margin><Insets top="8" right="24" bottom="12" left="24"/></VBox.margin>
            </Label>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent; -fx-padding: 0;">
                <VBox spacing="16" style="-fx-background-color: transparent;">
                    <padding><Insets top="0" right="24" bottom="0" left="24"/></padding>

                    <GridPane hgap="16">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="660" minWidth="500" hgrow="ALWAYS"/>
                            <ColumnConstraints prefWidth="260" minWidth="200" hgrow="SOMETIMES"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints vgrow="ALWAYS"/>
                        </rowConstraints>

                        <VBox spacing="14" GridPane.columnIndex="0"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 2); -fx-padding: 22;">
                            <Label text="Recent Activity:" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111111;"/>
                            <VBox fx:id="recentActivityContainer" spacing="12"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="12" GridPane.columnIndex="1">
                            <VBox alignment="CENTER" spacing="8" VBox.vgrow="ALWAYS"
                                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 2); -fx-padding: 32 20;">
                                <Label fx:id="daysUntilFollowUpLabel" text="—" style="-fx-font-size: 64px; -fx-font-weight: bold; -fx-text-fill: #7B1A1A;"/>
                                <Label text="Days" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111111;"/>
                                <Label fx:id="followUpDetailsLabel" text="No upcoming follow-up" wrapText="true" alignment="CENTER" style="-fx-font-size: 12px; -fx-text-fill: #666666; -fx-padding: 8 0 0 0;"/>
                                <Label fx:id="followUpDoctorLabel" text="" wrapText="true" alignment="CENTER" style="-fx-font-size: 12px; -fx-text-fill: #666666;"/>
                            </VBox>
                        </VBox>
                    </GridPane>

                    <GridPane hgap="16">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="660" minWidth="500" hgrow="ALWAYS"/>
                            <ColumnConstraints prefWidth="260" minWidth="200" hgrow="SOMETIMES"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints vgrow="ALWAYS"/>
                        </rowConstraints>

                        <VBox spacing="10" GridPane.columnIndex="0"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 2); -fx-padding: 22;">
                            <Label text="Medication Notes:" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111111;"/>
                            <VBox fx:id="medicationNotesContainer" spacing="12"/>
                        </VBox>

                        <VBox spacing="10" GridPane.columnIndex="1"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 2); -fx-padding: 22;">
                            <Label text="Schedule:" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111111;"/>
                            <VBox fx:id="scheduleContainer" spacing="12"/>
                        </VBox>
                    </GridPane>

                    <Pane minHeight="24"/>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>