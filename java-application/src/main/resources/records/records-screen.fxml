<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="records.RecordsController"
            style="-fx-font-family: 'Segoe UI', 'Roboto', sans-serif;">

    <!-- TOP -->
    <top>
        <VBox spacing="0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E8EEF5; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="24" right="32" bottom="24" left="32"/>
            </padding>

            <HBox spacing="16" alignment="CENTER_LEFT">

                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Scan Records"
                           style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1A2332;"/>
                    <Label text="Manage and review all patient scan records"
                           style="-fx-font-size: 12; -fx-text-fill: #6B7280; -fx-font-style: italic;"/>
                </VBox>

                <HBox spacing="12" alignment="CENTER_RIGHT">

                    <Button text="Back" onAction="#handleBack"
                            style="-fx-font-size: 11; -fx-padding: 10 18; -fx-background-color: #F3F4F6; -fx-text-fill:

                            #374151; -fx-border-color: #D1D5DB; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6;"/>

                    <Button fx:id="refreshButton" text="⟳ Refresh" onAction="#handleRefresh"
                            style="-fx-font-size: 11; -fx-padding: 10 18; -fx-background-color: #F3F4F6; -fx-text-fill: #374151; -fx-border-color: #D1D5DB; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6;"/>

                    <Button fx:id="addRecordButton" text="+ New Record"  onAction="#handleAddRecord"
                            style="-fx-font-size: 11; -fx-padding: 10 20; -fx-background-color: #0066CC; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER -->
    <center>
        <VBox spacing="16" style="-fx-background-color: #F9FAFB;">
            <padding>
                <Insets top="24" right="32" bottom="32" left="32"/>
            </padding>

            <!-- SEARCH PANEL -->
            <HBox spacing="12" alignment="CENTER_LEFT"
                  style="-fx-background-color: FFFFFF; -fx-padding: 16; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-color: #E8EEF5; -fx-border-width: 1;">

                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Search Records"
                           style="-fx-font-size: 12; -fx-text-fill: #6B7280; -fx-font-weight: bold;"/>

                    <TextField fx:id="searchField"
                               promptText="Search by Patient ID..."
                               style="-fx-font-size: 11; -fx-padding: 10; -fx-border-color: #D1D5DB; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Filter by Status"
                           style="-fx-font-size: 12; -fx-text-fill: #6B7280; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="statusFilter" prefWidth="150"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="From Date"
                           style="-fx-font-size: 12; -fx-text-fill: #6B7280; -fx-font-weight: bold;"/>
                    <DatePicker fx:id="fromDatePicker"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="To Date"
                           style="-fx-font-size: 12; -fx-text-fill: #6B7280; -fx-font-weight: bold;"/>
                    <DatePicker fx:id="toDatePicker"/>
                </VBox>

                <VBox alignment="BOTTOM_CENTER">
                    <Button fx:id="clearFiltersButton" text="Clear"  onAction="#handleClearFilters"
                            style="-fx-font-size: 11; -fx-padding: 8 16; -fx-background-color: #F3F4F6; -fx-text-fill: #6B7280;"/>
                </VBox>
            </HBox>

            <!-- TABLE -->
            <VBox spacing="12" VBox.vgrow="ALWAYS">

                <Label text="All Records"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1A2332;"/>

                <TableView fx:id="recordsTable">

                    <columns>

                        <!-- FIXED: Patient ID replaces Record ID -->
                        <TableColumn fx:id="patientIdColumn"
                                     text="Patient ID"
                                     prefWidth="140"/>

                        <TableColumn fx:id="patientNameColumn"
                                     text="Patient Name"
                                     prefWidth="160"/>

                        <TableColumn fx:id="scanDateColumn"
                                     text="Scan Date"
                                     prefWidth="130"/>

                        <TableColumn fx:id="scanTypeColumn"
                                     text="Scan Type"
                                     prefWidth="120"/>

                        <TableColumn fx:id="statusColumn"
                                     text="Status"
                                     prefWidth="110"/>

                        <TableColumn fx:id="diagnosisColumn"
                                     text="Diagnosis"
                                     prefWidth="160"/>

                        <TableColumn fx:id="actionsColumn"
                                     text="Actions"
                                     sortable="false"
                                     prefWidth="120"/>

                    </columns>

                    <placeholder>
                        <VBox spacing="12" alignment="CENTER" style="-fx-padding: 60;">
                            <Label text="📋"
                                   style="-fx-font-size: 48; -fx-text-fill: #D1D5DB;"/>

                            <Label text="No Patient Records Found"
                                   style="-fx-font-size: 16; -fx-text-fill: #6B7280; -fx-font-weight: bold;"/>

                            <Label text="Search by Patient ID or create a new record"
                                   style="-fx-font-size: 12; -fx-text-fill: #9CA3AF;"/>
                        </VBox>
                    </placeholder>

                </TableView>
            </VBox>

        </VBox>
    </center>

    <!-- BOTTOM -->
    <bottom>
        <HBox spacing="16"
              alignment="CENTER_LEFT"
              style="-fx-background-color: #F3F4F6; -fx-border-color: #E8EEF5; -fx-border-width: 1 0 0 0;">

            <padding>
                <Insets top="12" right="32" bottom="12" left="32"/>
            </padding>

            <!-- 🔥 LOGO ADDED (BOTTOM LEFT) -->
            <Label text="dAIbetes"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #111;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="statusBarLabel" text="Ready"
                   style="-fx-font-size: 11; -fx-text-fill: #6B7280;"/>

            <Label text="Last updated:"
                   style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;"/>

            <Label fx:id="lastUpdatedLabel"
                   text="--:--"
                   style="-fx-font-size: 11; -fx-text-fill: #6B7280; -fx-font-weight: bold;"/>

        </HBox>
    </bottom>

</BorderPane>