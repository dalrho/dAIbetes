<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<VBox prefHeight="900.0" prefWidth="1300.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.daibetes.modules.doctor.ui.GenerateResultsController">
    <children>
        <!-- 1. Header Navigation -->
        <HBox alignment="CENTER_LEFT" prefHeight="75.0" spacing="20.0" style="-fx-background-color: white; -fx-padding: 0 30 0 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 1);">
            <children>
                <TextFlow>
                    <Text text="d" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #1E293B;"/>
                    <Text text="AI" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #94A3B8;"/>
                    <Text text="betes" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #1E293B;"/>
                </TextFlow>
                <Separator orientation="VERTICAL" prefHeight="35.0" />
                <Label text="DIAGNOSTIC REPORT GENERATOR" style="-fx-font-weight: bold; -fx-text-fill: #64748B;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleBack" style="-fx-background-color: transparent; -fx-border-color: #CBD5E1; -fx-border-radius: 5; -fx-text-fill: #1E293B; -fx-padding: 8 20;" text="Back" />
                <Button onAction="#handleSaveReport" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #0F172A; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="SAVE REPORT" />
            </children>
        </HBox>

        <HBox spacing="25.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
            </padding>
            <children>
                <!-- LEFT SIDE: Evidence -->
                <!-- LEFT SIDE: Image and AI Assistant -->
                <VBox prefWidth="450.0" spacing="20.0">
                    <children>
                        <!-- Scan Card -->
                        <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B; -fx-font-size: 11px;" text="REFERENCE SCAN" />
                                <StackPane prefHeight="300.0" style="-fx-background-color: #F1F5F9; -fx-background-radius: 8;">
                                    <children>
                                        <ImageView fx:id="reportImageView" fitHeight="280.0" fitWidth="400.0" preserveRatio="true" />
                                    </children>
                                </StackPane>
                                <Button onAction="#handleAIDetection" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="✨ RUN AI ASSISTANT" />
                            </children>
                        </VBox>

                        <!-- AI ASSISTANT INSIGHTS CARD -->
                        <VBox fx:id="aiResultBox" spacing="12.0" style="-fx-background-color: #F0F9FF; -fx-background-radius: 12; -fx-padding: 20; -fx-border-color: #BAE6FD; -fx-border-width: 1;">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #0369A1;" text="AI ASSISTANT INSIGHTS" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <ProgressIndicator fx:id="aiLoader" prefHeight="20.0" prefWidth="20.0" visible="false" />
                                    </children>
                                </HBox>
                                <Separator prefWidth="200.0" style="-fx-opacity: 0.3;" />
                                <VBox spacing="5.0">
                                    <children>
                                        <HBox spacing="10.0">
                                            <children>
                                                <Label style="-fx-text-fill: #0C4A6E; -fx-font-weight: bold;" text="Suggested Criticality:" />
                                                <Label fx:id="aiCriticalityLabel" style="-fx-text-fill: #0284C7; -fx-font-weight: bold;" text="Pending..." />
                                            </children>
                                        </HBox>
                                        <HBox spacing="10.0">
                                            <children>
                                                <Label style="-fx-text-fill: #0C4A6E; -fx-font-weight: bold;" text="Confidence Score:" />
                                                <Label fx:id="aiConfidenceLabel" style="-fx-text-fill: #0284C7;" text="--%" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                                <Label style="-fx-text-fill: #0C4A6E; -fx-font-weight: bold;" text="AI Brief Explanation:" />
                                <Label fx:id="aiExplanationLabel" style="-fx-text-fill: #334155;" text="Click the button above to begin automated analysis." wrapText="true" />
                            </children>
                        </VBox>

                        <!-- Doctor Criticality Analysis -->
                        <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #1E293B;" text="DOCTOR'S FINAL CRITICALITY" />
                                <ComboBox fx:id="criticalityCombo" maxWidth="Infinity" promptText="Select Confirmed Level" />
                                <TextArea fx:id="doctorCriticalityArea" prefHeight="100.0" promptText="Enter clinical reasoning for this diagnosis..." style="-fx-background-radius: 8;" wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
                <!-- RIGHT SIDE: Scrollable Checklist -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" HBox.hgrow="ALWAYS">
                    <content>
                        <VBox spacing="25.0">
                            <children>
                                <!-- PATHOLOGICAL FINDINGS -->
                                <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 16px;" text="PATHOLOGICAL FINDINGS" />
                                        <Separator />
                                        <GridPane hgap="40.0" vgap="35.0">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="350.0" />
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="350.0" />
                                            </columnConstraints>
                                            <children>
                                                <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                                    <Label text="1. Microaneurysms" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                                                    <HBox spacing="15">
                                                        <RadioButton text="Absent" style="-fx-text-fill: #1E293B;"><toggleGroup><ToggleGroup fx:id="tgMA"/></toggleGroup></RadioButton>
                                                        <RadioButton text="Mild" toggleGroup="$tgMA" style="-fx-text-fill: #1E293B;" />
                                                        <RadioButton text="Moderate" toggleGroup="$tgMA" style="-fx-text-fill: #1E293B;" />
                                                        <RadioButton text="Severe" toggleGroup="$tgMA" style="-fx-text-fill: #1E293B;" />
                                                    </HBox>
                                                </VBox>
                                                <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                                    <Label text="2. Retinal Hemorrhages" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                                                    <HBox spacing="15">
                                                        <RadioButton text="Absent" style="-fx-text-fill: #1E293B;"><toggleGroup><ToggleGroup fx:id="tgHem"/></toggleGroup></RadioButton>
                                                        <RadioButton text="Few" toggleGroup="$tgHem" style="-fx-text-fill: #1E293B;" />
                                                        <RadioButton text="Multiple" toggleGroup="$tgHem" style="-fx-text-fill: #1E293B;" />
                                                        <RadioButton text="Extensive" toggleGroup="$tgHem" style="-fx-text-fill: #1E293B;" />
                                                    </HBox>
                                                </VBox>
                                                <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                                    <Label text="3. Hard Exudates" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                                                    <HBox spacing="15">
                                                        <RadioButton text="Absent" style="-fx-text-fill: #1E293B;"><toggleGroup><ToggleGroup fx:id="tgExu"/></toggleGroup></RadioButton>
                                                        <RadioButton text="Present" toggleGroup="$tgExu" style="-fx-text-fill: #1E293B;" />
                                                        <RadioButton text="Macular" toggleGroup="$tgExu" style="-fx-text-fill: #1E293B;" />
                                                    </HBox>
                                                </VBox>
                                                <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                                    <Label text="4. Cotton-Wool Spots" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                                                    <HBox spacing="15">
                                                        <RadioButton text="Absent" style="-fx-text-fill: #1E293B;"><toggleGroup><ToggleGroup fx:id="tgCWS"/></toggleGroup></RadioButton>
                                                        <RadioButton text="Present" toggleGroup="$tgCWS" style="-fx-text-fill: #1E293B;" />
                                                    </HBox>
                                                </VBox>
                                                <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                                    <Label text="5. Macular Edema" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                                                    <HBox spacing="15">
                                                        <RadioButton text="Absent" style="-fx-text-fill: #1E293B;"><toggleGroup><ToggleGroup fx:id="tgME"/></toggleGroup></RadioButton>
                                                        <RadioButton text="Suspect" toggleGroup="$tgME" style="-fx-text-fill: #1E293B;" />
                                                        <RadioButton text="CSME" toggleGroup="$tgME" style="-fx-text-fill: #1E293B;" />
                                                    </HBox>
                                                </VBox>
                                                <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                                    <Label text="6. Venous Beading" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                                                    <HBox spacing="15">
                                                        <RadioButton text="Absent" style="-fx-text-fill: #1E293B;"><toggleGroup><ToggleGroup fx:id="tgVB"/></toggleGroup></RadioButton>
                                                        <RadioButton text="Present" toggleGroup="$tgVB" style="-fx-text-fill: #1E293B;" />
                                                    </HBox>
                                                </VBox>
                                                <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                                    <Label text="7. IRMA" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                                                    <HBox spacing="15">
                                                        <RadioButton text="Absent" style="-fx-text-fill: #1E293B;"><toggleGroup><ToggleGroup fx:id="tgIRMA"/></toggleGroup></RadioButton>
                                                        <RadioButton text="Present" toggleGroup="$tgIRMA" style="-fx-text-fill: #1E293B;" />
                                                    </HBox>
                                                </VBox>
                                                <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                                    <Label text="8. Neovascularization" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                                                    <HBox spacing="15">
                                                        <RadioButton text="Absent" style="-fx-text-fill: #1E293B;"><toggleGroup><ToggleGroup fx:id="tgNV"/></toggleGroup></RadioButton>
                                                        <RadioButton text="Disc" toggleGroup="$tgNV" style="-fx-text-fill: #1E293B;" />
                                                        <RadioButton text="Elsewhere" toggleGroup="$tgNV" style="-fx-text-fill: #1E293B;" />
                                                    </HBox>
                                                </VBox>
                                                <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="4">
                                                    <Label text="9. Vitreous Hemorrhage" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                                                    <HBox spacing="15">
                                                        <RadioButton text="Absent" style="-fx-text-fill: #1E293B;"><toggleGroup><ToggleGroup fx:id="tgVH"/></toggleGroup></RadioButton>
                                                        <RadioButton text="Present" toggleGroup="$tgVH" style="-fx-text-fill: #1E293B;" />
                                                    </HBox>
                                                </VBox>
                                                <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="4">
                                                    <Label text="10. Retinal Detachment" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                                                    <HBox spacing="15">
                                                        <RadioButton text="Absent" style="-fx-text-fill: #1E293B;"><toggleGroup><ToggleGroup fx:id="tgRD"/></toggleGroup></RadioButton>
                                                        <RadioButton text="Suspect" toggleGroup="$tgRD" style="-fx-text-fill: #1E293B;" />
                                                        <RadioButton text="Present" toggleGroup="$tgRD" style="-fx-text-fill: #1E293B;" />
                                                    </HBox>
                                                </VBox>
                                            </children>
                                        </GridPane>
                                    </children>
                                </VBox>

                                <!-- FINAL GRADING -->
                                <HBox spacing="20.0">
                                    <children>
                                        <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #E11D48;" text="FINAL DR GRADE" />
                                                <VBox spacing="12">
                                                    <RadioButton text="No DR (Grade 0)" style="-fx-text-fill: #1E293B;"><toggleGroup><ToggleGroup fx:id="tgDR"/></toggleGroup></RadioButton>
                                                    <RadioButton text="Mild NPDR (Grade 1)" toggleGroup="$tgDR" style="-fx-text-fill: #1E293B;" />
                                                    <RadioButton text="Moderate NPDR (Grade 2)" toggleGroup="$tgDR" style="-fx-text-fill: #1E293B;" />
                                                    <RadioButton text="Severe NPDR (Grade 3)" toggleGroup="$tgDR" style="-fx-text-fill: #1E293B;" />
                                                    <RadioButton text="Proliferative DR (PDR)" toggleGroup="$tgDR" style="-fx-text-fill: #1E293B;" />
                                                </VBox>
                                            </children>
                                        </VBox>
                                        <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #E11D48;" text="MACULAR EDEMA (DME)" />
                                                <VBox spacing="12">
                                                    <RadioButton text="No DME" style="-fx-text-fill: #1E293B;"><toggleGroup><ToggleGroup fx:id="tgDME"/></toggleGroup></RadioButton>
                                                    <RadioButton text="Mild" toggleGroup="$tgDME" style="-fx-text-fill: #1E293B;" />
                                                    <RadioButton text="Moderate" toggleGroup="$tgDME" style="-fx-text-fill: #1E293B;" />
                                                    <RadioButton text="Severe" toggleGroup="$tgDME" style="-fx-text-fill: #1E293B;" />
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- RECOMMENDATIONS -->
                                <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #1E293B;" text="MANAGEMENT &amp; RECOMMENDATIONS" />
                                        <FlowPane hgap="30.0" vgap="20.0">
                                            <children>
                                                <CheckBox text="Annual Follow-up" style="-fx-text-fill: #1E293B;" />
                                                <CheckBox text="6-month Follow-up" style="-fx-text-fill: #1E293B;" />
                                                <CheckBox text="Refer to Specialist" style="-fx-text-fill: #1E293B;" />
                                                <CheckBox text="Urgent Evaluation" style="-fx-text-fill: #1E293B;" />
                                                <CheckBox text="Laser Treatment" style="-fx-text-fill: #1E293B;" />
                                                <CheckBox text="Anti-VEGF Therapy" style="-fx-text-fill: #1E293B;" />
                                            </children>
                                        </FlowPane>
                                        <TextArea fx:id="notesArea" prefHeight="80.0" promptText="Enter final clinical notes..." style="-fx-background-radius: 8; -fx-border-color: #E2E8F0;" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </HBox>
    </children>
</VBox>