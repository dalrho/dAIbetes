<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.daibetes.modules.auth.login.controller.ForgotPasswordController">

    <StackPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <VBox alignment="CENTER" spacing="25" fillWidth="false">

            <!-- LOGO -->
            <VBox alignment="CENTER" spacing="5">
                <TextFlow textAlignment="CENTER">
                    <Text text="d" style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-fill: black;" />
                    <Text text="AI" style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-fill: #9e9e9e;" />
                    <Text text="betes" style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-fill: black;" />
                </TextFlow>
            </VBox>

            <!-- CARD -->
            <VBox spacing="20" alignment="CENTER" prefWidth="400"
                  style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 10);">

                <Label text="Reset Password" style="-fx-font-size: 22px; -fx-font-weight: bold;" />

                <VBox spacing="5" maxWidth="300">
                    <Label text="Email:" />
                    <TextField fx:id="emailField" prefHeight="35"
                               style="-fx-background-radius: 8; -fx-background-color: black; -fx-text-fill: white;" />
                </VBox>

                <VBox spacing="5" maxWidth="300">
                    <Label text="New Password:" />
                    <PasswordField fx:id="newPasswordField" prefHeight="35"
                                   style="-fx-background-radius: 8; -fx-background-color: black; -fx-text-fill: white;" />
                </VBox>

                <Label fx:id="statusLabel" wrapText="true" />

                <VBox spacing="10" alignment="CENTER">
                    <Button text="Update Password" onAction="#handleReset" maxWidth="Infinity"
                            style="-fx-background-color: #d71919; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10;" />

                    <Button text="Back to Login" onAction="#handleBack"
                            style="-fx-background-color: transparent; -fx-text-fill: #555; -fx-cursor: hand;" />
                </VBox>
            </VBox>
        </VBox>
    </StackPane>
</AnchorPane>