<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #F4F7F9;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.daibetes.modules.detection.ui.ImageProcessingController">
    <children>
        <!-- 1. Header Navigation Bar -->
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0" style="-fx-background-color: #263238; -fx-padding: 0 25 0 25;">
            <children>
                <Button onAction="#handleBackToGallery" style="-fx-background-color: #455A64; -fx-text-fill: white; -fx-cursor: hand;" text="← BACK TO GALLERY" />
                <Separator orientation="VERTICAL" prefHeight="30.0">
                    <padding>
                        <Insets bottom="10.0" top="10.0" />
                    </padding></Separator>
                <Label text="DIAGNOSTIC IMAGE ENHANCEMENT" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleReset" style="-fx-background-color: transparent; -fx-text-fill: #CFD8DC; -fx-border-color: #CFD8DC; -fx-border-radius: 3; -fx-cursor: hand;" text="RESET ALL FILTERS" />
            </children>
        </HBox>

        <!-- 2. Main Workspace -->
        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <!-- Left Pane: Original -->
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #546E7A;" text="ORIGINAL (RAW) SCAN" />
                        <ScrollPane fx:id="rawScroll" fitToHeight="true" fitToWidth="true" pannable="true" style="-fx-background-color: transparent; -fx-background: #FFFFFF; -fx-border-color: #CFD8DC; -fx-border-radius: 5; -fx-background-radius: 5;" VBox.vgrow="ALWAYS">
                            <content>
                                <StackPane alignment="CENTER">
                                    <children>
                                        <ImageView fx:id="rawImageView" fitWidth="420.0" preserveRatio="true" />
                                    </children>
                                </StackPane>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>

                <!-- Right Pane: Enhanced -->
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #1976D2;" text="ENHANCED PREVIEW" />
                        <HBox spacing="10.0" VBox.vgrow="ALWAYS">
                            <children>
                                <ScrollPane fx:id="enhancedScroll" fitToHeight="true" fitToWidth="true" pannable="true" style="-fx-background-color: transparent; -fx-background: #FFFFFF; -fx-border-color: #1976D2; -fx-border-radius: 5; -fx-background-radius: 5;" HBox.hgrow="ALWAYS">
                                    <content>
                                        <StackPane alignment="CENTER">
                                            <children>
                                                <ImageView fx:id="enhancedImageView" fitWidth="420.0" preserveRatio="true" />
                                            </children>
                                        </StackPane>
                                    </content>
                                </ScrollPane>
                                <!-- Vertical Zoom Slider -->
                                <VBox alignment="CENTER" spacing="8.0" style="-fx-padding: 0 5 0 5;">
                                    <children>
                                        <Label text="ZOOM" textFill="#546E7A">
                                            <font>
                                                <Font name="System Bold" size="9.0" />
                                            </font>
                                        </Label>
                                        <Slider fx:id="zoomSlider" max="4.0" min="1.0" orientation="VERTICAL" prefHeight="300.0" value="1.0" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- 3. Control Dashboard -->
        <HBox prefHeight="160.0" spacing="25.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CFD8DC transparent transparent transparent; -fx-padding: 20;">
            <children>
                <!-- Global Settings Group -->
                <VBox prefWidth="160.0" spacing="12.0">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #37474F;" text="Preprocessing" />
                        <ToggleButton fx:id="grayscaleToggle" maxWidth="1.7976931348623157E308" onAction="#updatePreview" prefHeight="30.0" style="-fx-cursor: hand;" text="GRAYSCALE MODE" />
                        <VBox spacing="3.0">
                            <children>
                                <Label text="Target Resolution" textFill="#78909C">
                                    <font>
                                        <Font size="11.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="resizeCombo" maxWidth="1.7976931348623157E308" onAction="#updatePreview" prefHeight="30.0" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <Separator orientation="VERTICAL" />

                <!-- Filters Grid -->
                <GridPane hgap="40.0" vgap="15.0" HBox.hgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" />
                    </columnConstraints>
                    <children>
                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <children>
                                <HBox>
                                    <Label text="Brightness" textFill="#455A64" />
                                    <Region HBox.hgrow="ALWAYS" />
                                </HBox>
                                <Slider fx:id="brightnessSlider" max="0.5" min="-0.5" onMouseReleased="#updatePreview" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <children>
                                <Label text="Contrast (CLAHE)" textFill="#455A64" />
                                <Slider fx:id="claheSlider" max="3.0" min="0.5" onMouseReleased="#updatePreview" value="1.0" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <children>
                                <Label text="Edge Sharpness" textFill="#455A64" />
                                <Slider fx:id="sharpSlider" max="10.0" onMouseReleased="#updatePreview" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <children>
                                <Label text="Noise Reduction" textFill="#455A64" />
                                <Slider fx:id="denoiseSlider" max="1.0" onMouseReleased="#updatePreview" />
                            </children>
                        </VBox>
                    </children>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                </GridPane>

                <Separator orientation="VERTICAL" />

                <!-- Action Section -->
                <VBox alignment="CENTER" prefWidth="200.0" spacing="10.0">
                    <children>
                        <Button onAction="#handleGenerateReport" prefHeight="55.0" prefWidth="180.0" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14; -fx-cursor: hand; -fx-background-radius: 5;" text="GENERATE REPORT" />
                        <Label text="Finalize and save results" textFill="#90A4AE">
                            <font>
                                <Font name="System Italic" size="10.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>