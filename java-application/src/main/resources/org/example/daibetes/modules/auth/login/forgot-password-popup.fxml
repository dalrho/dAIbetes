<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20" style="-fx-background-color: #f4f4f4; -fx-padding: 40;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.daibetes.modules.auth.login.controller.ForgotPasswordController">

    <!-- Header mirroring Login UI -->
    <VBox alignment="CENTER" spacing="5">
        <TextFlow textAlignment="CENTER">
            <Text text="d" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: black;" />
            <Text text="AI" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: #9e9e9e;" />
            <Text text="betes" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: black;" />
        </TextFlow>
    </VBox>

    <VBox spacing="15" alignment="CENTER" prefWidth="350"
          style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 10);">

        <Label text="Reset Password" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <VBox spacing="5">
            <Label text="Confirm Email:" />
            <TextField fx:id="emailField" promptText="Enter registered email"
                       style="-fx-background-radius: 8; -fx-background-color: #f0f0f0;" />
        </VBox>

        <VBox spacing="5">
            <Label text="New Password:" />
            <PasswordField fx:id="newPasswordField"
                           style="-fx-background-radius: 8; -fx-background-color: #f0f0f0;" />
        </VBox>

        <Label fx:id="statusLabel" wrapText="true" style="-fx-font-size: 11px;" />

        <HBox spacing="10" alignment="CENTER">
            <Button text="Cancel" onAction="#handleCancel"
                    style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-background-radius: 8;" />
            <Button text="Update Password" onAction="#handleReset"
                    style="-fx-background-color: #d71919; -fx-text-fill: white; -fx-background-radius: 8;" />
        </HBox>
    </VBox>
</VBox>