<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="900.0" prefWidth="1300.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.daibetes.modules.doctor.ui.report.controller.EditGenerateResultsController">
    <children>
        <!-- 1. Header Navigation -->
        <HBox alignment="CENTER_LEFT" prefHeight="75.0" spacing="20.0" style="-fx-background-color: white; -fx-padding: 0 30 0 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 1);">
            <children>
                <TextFlow>
                    <Text style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #1E293B;" text="d" />
                    <Text style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #94A3B8;" text="AI" />
                    <Text style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #1E293B;" text="betes" />
                </TextFlow>
                <Separator orientation="VERTICAL" prefHeight="35.0" />
                <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="DIAGNOSTIC REPORT GENERATOR" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleBack" style="-fx-background-color: transparent; -fx-border-color: #CBD5E1; -fx-border-radius: 5; -fx-text-fill: #1E293B; -fx-padding: 8 20;" text="Back" />
                <Button onAction="#handleSaveReport" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #0F172A; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="SAVE REPORT" />
            </children>
        </HBox>

        <HBox spacing="25.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
            </padding>
            <children>
                <!-- LEFT SIDE -->
                <VBox prefWidth="450.0" spacing="20.0">
                    <children>
                        <!-- ADDED: PATIENT IDENTIFICATION -->
                        <VBox spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4); -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-border-radius: 12;">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B; -fx-font-size: 11px;" text="PATIENT IDENTIFICATION" />
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 18px;" text="Name:" />
                                        <Label fx:id="patientNameLabel" style="-fx-text-fill: #0F172A; -fx-font-size: 18px; -fx-font-weight: bold;" text="-- Select Patient --" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Scan Card -->
                        <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B; -fx-font-size: 11px;" text="REFERENCE SCAN" />
                                <StackPane prefHeight="300.0" style="-fx-background-color: #F1F5F9; -fx-background-radius: 8;">
                                    <children>
                                        <ImageView fx:id="reportImageView" fitHeight="280.0" fitWidth="400.0" preserveRatio="true" />
                                    </children>
                                </StackPane>
                                <Button maxWidth="Infinity" onAction="#handleAIDetection" prefHeight="45.0" style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="✨ RUN AI ASSISTANT" />
                            </children>
                        </VBox>

                        <VBox fx:id="aiResultBox" minHeight="237.0" prefHeight="237.0" prefWidth="436.0" spacing="0.0" style="-fx-background-color: #F0F9FF; -fx-background-radius: 12; -fx-border-color: #BAE6FD; -fx-border-width: 1; -fx-border-radius: 12;">
                            <children>
                                <!-- Sticky Top Section (Criticality & Confidence) -->
                                <VBox spacing="12.0" style="-fx-padding: 20 20 10 20;">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #0369A1;" text="AI ASSISTANT INSIGHTS" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <ProgressIndicator fx:id="aiLoader" prefHeight="20.0" prefWidth="20.0" visible="false" />
                                            </children>
                                        </HBox>
                                        <Separator prefWidth="200.0" style="-fx-opacity: 0.3;" />
                                        <VBox spacing="5.0">
                                            <children>
                                                <HBox spacing="10.0">
                                                    <children>
                                                        <Label style="-fx-text-fill: #0C4A6E; -fx-font-weight: bold;" text="Suggested Criticality:" />
                                                        <Label fx:id="aiCriticalityLabel" style="-fx-text-fill: #0284C7; -fx-font-weight: bold;" text="Pending..." />
                                                    </children>
                                                </HBox>
                                                <HBox spacing="10.0">
                                                    <children>
                                                        <Label style="-fx-text-fill: #0C4A6E; -fx-font-weight: bold;" text="Confidence Score:" />
                                                        <Label fx:id="aiConfidenceLabel" style="-fx-text-fill: #0284C7;" text="--%" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                                <VBox spacing="5.0" style="-fx-padding: 0 20 20 20;">
                                    <children>
                                        <Label style="-fx-text-fill: #0C4A6E; -fx-font-weight: bold;" text="AI Brief Explanation:" />
                                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="80.0" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
                                            <content>
                                                <Label fx:id="aiExplanationLabel" style="-fx-text-fill: #334155;" text="Click the button above to begin automated analysis." wrapText="true" />
                                            </content>
                                        </ScrollPane>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Doctor Criticality Analysis -->
                        <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #1E293B;" text="DOCTOR'S FINAL CRITICALITY" />
                                <ComboBox fx:id="criticalityCombo" maxWidth="Infinity" promptText="Select Confirmed Level" />
                                <TextArea fx:id="doctorCriticalityArea" prefHeight="100.0" promptText="Enter clinical reasoning for this diagnosis..." style="-fx-background-radius: 8;" wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
                <!-- RIGHT SIDE (Checklist) Remains Unchanged -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" HBox.hgrow="ALWAYS">
                    <content>
                        <VBox spacing="25.0">
                            <children>
                                <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 16px;" text="PATHOLOGICAL FINDINGS" />
                                        <Separator />
                                        <GridPane hgap="40.0" vgap="35.0">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="350.0" />
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="350.0" />
                                            </columnConstraints>
                                            <children>
                                                <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="1. Microaneurysms" />
                                                    <HBox spacing="15">
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Absent"><toggleGroup><ToggleGroup fx:id="tgMA" /></toggleGroup></RadioButton>
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Mild" toggleGroup="$tgMA" />
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Moderate" toggleGroup="$tgMA" />
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Severe" toggleGroup="$tgMA" />
                                                    </HBox>
                                                </VBox>
                                                <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="2. Retinal Hemorrhages" />
                                                    <HBox spacing="15">
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Absent"><toggleGroup><ToggleGroup fx:id="tgHem" /></toggleGroup></RadioButton>
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Few" toggleGroup="$tgHem" />
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Multiple" toggleGroup="$tgHem" />
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Extensive" toggleGroup="$tgHem" />
                                                    </HBox>
                                                </VBox>
                                                <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="3. Hard Exudates" />
                                                    <HBox spacing="15">
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Absent"><toggleGroup><ToggleGroup fx:id="tgExu" /></toggleGroup></RadioButton>
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Present" toggleGroup="$tgExu" />
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Macular" toggleGroup="$tgExu" />
                                                    </HBox>
                                                </VBox>
                                                <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="4. Cotton-Wool Spots" />
                                                    <HBox spacing="15">
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Absent"><toggleGroup><ToggleGroup fx:id="tgCWS" /></toggleGroup></RadioButton>
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Present" toggleGroup="$tgCWS" />
                                                    </HBox>
                                                </VBox>
                                                <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="5. Macular Edema" />
                                                    <HBox spacing="15">
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Absent"><toggleGroup><ToggleGroup fx:id="tgME" /></toggleGroup></RadioButton>
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Suspect" toggleGroup="$tgME" />
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="CSME" toggleGroup="$tgME" />
                                                    </HBox>
                                                </VBox>
                                                <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="6. Venous Beading" />
                                                    <HBox spacing="15">
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Absent"><toggleGroup><ToggleGroup fx:id="tgVB" /></toggleGroup></RadioButton>
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Present" toggleGroup="$tgVB" />
                                                    </HBox>
                                                </VBox>
                                                <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="7. IRMA" />
                                                    <HBox spacing="15">
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Absent"><toggleGroup><ToggleGroup fx:id="tgIRMA" /></toggleGroup></RadioButton>
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Present" toggleGroup="$tgIRMA" />
                                                    </HBox>
                                                </VBox>
                                                <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="8. Neovascularization" />
                                                    <HBox spacing="15">
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Absent"><toggleGroup><ToggleGroup fx:id="tgNV" /></toggleGroup></RadioButton>
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Disc" toggleGroup="$tgNV" />
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Elsewhere" toggleGroup="$tgNV" />
                                                    </HBox>
                                                </VBox>
                                                <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="4">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="9. Vitreous Hemorrhage" />
                                                    <HBox spacing="15">
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Absent"><toggleGroup><ToggleGroup fx:id="tgVH" /></toggleGroup></RadioButton>
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Present" toggleGroup="$tgVH" />
                                                    </HBox>
                                                </VBox>
                                                <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="4">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="10. Retinal Detachment" />
                                                    <HBox spacing="15">
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Absent"><toggleGroup><ToggleGroup fx:id="tgRD" /></toggleGroup></RadioButton>
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Suspect" toggleGroup="$tgRD" />
                                                        <RadioButton style="-fx-text-fill: #1E293B;" text="Present" toggleGroup="$tgRD" />
                                                    </HBox>
                                                </VBox>
                                            </children>
                                            <rowConstraints>
                                                <RowConstraints />
                                                <RowConstraints />
                                                <RowConstraints />
                                                <RowConstraints />
                                                <RowConstraints />
                                            </rowConstraints>
                                        </GridPane>
                                    </children>
                                </VBox>

                                <HBox spacing="20.0">
                                    <children>
                                        <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #E11D48;" text="FINAL DR GRADE" />
                                                <VBox spacing="12">
                                                    <RadioButton style="-fx-text-fill: #1E293B;" text="No DR (Grade 0)"><toggleGroup><ToggleGroup fx:id="tgDR" /></toggleGroup></RadioButton>
                                                    <RadioButton style="-fx-text-fill: #1E293B;" text="Mild NPDR (Grade 1)" toggleGroup="$tgDR" />
                                                    <RadioButton style="-fx-text-fill: #1E293B;" text="Moderate NPDR (Grade 2)" toggleGroup="$tgDR" />
                                                    <RadioButton style="-fx-text-fill: #1E293B;" text="Severe NPDR (Grade 3)" toggleGroup="$tgDR" />
                                                    <RadioButton style="-fx-text-fill: #1E293B;" text="Proliferative DR (PDR)" toggleGroup="$tgDR" />
                                                </VBox>
                                            </children>
                                        </VBox>
                                        <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #E11D48;" text="MACULAR EDEMA (DME)" />
                                                <VBox spacing="12">
                                                    <RadioButton style="-fx-text-fill: #1E293B;" text="No DME"><toggleGroup><ToggleGroup fx:id="tgDME" /></toggleGroup></RadioButton>
                                                    <RadioButton style="-fx-text-fill: #1E293B;" text="Mild" toggleGroup="$tgDME" />
                                                    <RadioButton style="-fx-text-fill: #1E293B;" text="Moderate" toggleGroup="$tgDME" />
                                                    <RadioButton style="-fx-text-fill: #1E293B;" text="Severe" toggleGroup="$tgDME" />
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #1E293B;" text="MANAGEMENT &amp; RECOMMENDATIONS" />
                                        <FlowPane hgap="30.0" vgap="20.0">
                                            <children>
                                                <CheckBox fx:id="annualFollowupCheck" style="-fx-text-fill: #1E293B;" text="Annual Follow-up" />
                                                <CheckBox fx:id="sixMonthCheck" style="-fx-text-fill: #1E293B;" text="6-month Follow-up" />
                                                <CheckBox fx:id="referCheck" style="-fx-text-fill: #1E293B;" text="Refer to Specialist" />
                                                <CheckBox fx:id="urgentCheck" style="-fx-text-fill: #1E293B;" text="Urgent Evaluation" />
                                                <CheckBox fx:id="laserCheck" style="-fx-text-fill: #1E293B;" text="Laser Treatment" />
                                                <CheckBox fx:id="antiVegfCheck" style="-fx-text-fill: #1E293B;" text="Anti-VEGF Therapy" />
                                            </children>
                                        </FlowPane>
                                        <TextArea fx:id="notesArea" prefHeight="80.0" promptText="Enter final clinical notes..." style="-fx-background-radius: 8; -fx-border-color: #E2E8F0;" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </HBox>
    </children>
</VBox>