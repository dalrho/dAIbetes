<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.daibetes.modules.patient.ui.upload.controller.ImageUploadController"
           style="-fx-background-color: rgba(0,0,0,0.3);">

    <!-- CARD (CENTER POPUP BOX) -->
    <VBox spacing="15"
          alignment="CENTER"
          maxWidth="750"
          maxHeight="-Infinity"
          style="-fx-background-color: white;
                 -fx-background-radius: 15;
                 -fx-padding: 20;">

        <!-- TOP BAR -->
        <HBox spacing="10" alignment="CENTER">
            <TextFlow>
                <Text text="d" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-fill: #111111;"/>
                <Text text="AI" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-fill: #999999;"/>
                <Text text="betes" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-fill: #111111;"/>
            </TextFlow>

            <Label text="Click an image to select it for analysis"
                   style="-fx-text-fill: gray; -fx-font-size: 12px;"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Button text="Back"
                    fx:id="backBtn"
                    onAction="#onBack"
                    style="-fx-background-color: red;
                           -fx-text-fill: white;
                           -fx-background-radius: 8;"/>
        </HBox>

        <Separator/>

        <!-- IMAGE PREVIEW -->
        <HBox spacing="15" alignment="CENTER">

            <VBox fx:id="box1" onMouseClicked="#onSelect1" alignment="CENTER" spacing="10" style="-fx-cursor: hand;">
                <ImageView fx:id="img1"
                           fitWidth="180"
                           fitHeight="180"
                           preserveRatio="true"
                           style="-fx-background-color: #eee;"/>
                <Button text="Remove" onAction="#remove1"/>
            </VBox>

            <VBox fx:id="box2" onMouseClicked="#onSelect2" alignment="CENTER" spacing="10" style="-fx-cursor: hand;">
                <ImageView fx:id="img2"
                           fitWidth="180"
                           fitHeight="180"
                           preserveRatio="true"
                           style="-fx-background-color: #eee;"/>
                <Button text="Remove" onAction="#remove2"/>
            </VBox>

            <VBox fx:id="box3" onMouseClicked="#onSelect3" alignment="CENTER" spacing="10" style="-fx-cursor: hand;">
                <ImageView fx:id="img3"
                           fitWidth="180"
                           fitHeight="180"
                           preserveRatio="true"
                           style="-fx-background-color: #eee;"/>
                <Button text="Remove" onAction="#remove3"/>
            </VBox>

        </HBox>

        <Separator/>

        <!-- ACTION BUTTONS -->
        <HBox spacing="15" alignment="CENTER">

            <Button text="Upload Images"
                    onAction="#onUpload"
                    style="-fx-background-color: black;
                           -fx-text-fill: white;
                           -fx-background-radius: 10;
                           -fx-padding: 8 20; -fx-cursor: hand;"/>

            <Button text="Capture Photo"
                    onAction="#onCapturePhoto"
                    style="-fx-background-color: #3B82F6;
                           -fx-text-fill: white;
                           -fx-background-radius: 10;
                           -fx-padding: 8 20; -fx-cursor: hand;"/>

            <Button text="Next"
                    onAction="#onNext"
                    style="-fx-background-color: #2ecc71;
                           -fx-text-fill: white;
                           -fx-background-radius: 10;
                           -fx-padding: 8 20; -fx-cursor: hand;"/>

        </HBox>

    </VBox>

</StackPane>