<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-font-family: 'Segoe UI', 'Roboto', sans-serif;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.daibetes.modules.records.controller.RecordsController">

    <!-- TOP -->
    <top>
        <VBox spacing="0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E8EEF5; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="24" left="32" right="32" top="24" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="16">

                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1A2332;" text="Scan Records" />
                    <Label style="-fx-font-size: 12; -fx-text-fill: #6B7280; -fx-font-style: italic;" text="Manage and review all patient scan records" />
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="12">

                    <Button onAction="#handleBack" style="-fx-font-size: 11; -fx-padding: 10 18; -fx-background-color: #F3F4F6; -fx-text-fill:                              #374151; -fx-border-color: #D1D5DB; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6;" text="Back" />

                    <Button fx:id="refreshButton" onAction="#handleRefresh" style="-fx-font-size: 11; -fx-padding: 10 18; -fx-background-color: #F3F4F6; -fx-text-fill: #374151; -fx-border-color: #D1D5DB; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6;" text="⟳ Refresh" />

                    <Button fx:id="addRecordButton" onAction="#handleAddRecord" style="-fx-font-size: 11; -fx-padding: 10 20; -fx-background-color: #0066CC; -fx-text-fill: WHITE; -fx-font-weight: bold; -fx-border-radius: 6; -fx-background-radius: 6;" text="+ New Record" />
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER -->
    <center>
        <VBox spacing="16" style="-fx-background-color: #F9FAFB;">
            <padding>
                <Insets bottom="32" left="32" right="32" top="24" />
            </padding>

            <!-- SEARCH PANEL -->
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: FFFFFF; -fx-padding: 16; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-color: #E8EEF5; -fx-border-width: 1;">

                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 12; -fx-text-fill: #6B7280; -fx-font-weight: bold;" text="Search Records" />

                    <TextField fx:id="searchField" promptText="Search by Patient ID..." style="-fx-font-size: 11; -fx-padding: 10; -fx-border-color: #D1D5DB; -fx-border-radius: 6; -fx-background-radius: 6;" />
                </VBox>

                <VBox spacing="6">
                    <Label style="-fx-font-size: 12; -fx-text-fill: #6B7280; -fx-font-weight: bold;" text="Filter by Status" />
                    <ComboBox fx:id="statusFilter" prefWidth="150" />
                </VBox>

                <VBox spacing="6">
                    <Label style="-fx-font-size: 12; -fx-text-fill: #6B7280; -fx-font-weight: bold;" text="From Date" />
                    <DatePicker fx:id="fromDatePicker" />
                </VBox>

                <VBox spacing="6">
                    <Label style="-fx-font-size: 12; -fx-text-fill: #6B7280; -fx-font-weight: bold;" text="To Date" />
                    <DatePicker fx:id="toDatePicker" />
                </VBox>

                <VBox alignment="BOTTOM_CENTER">
                    <Button fx:id="clearFiltersButton" onAction="#handleClearFilters" style="-fx-font-size: 11; -fx-padding: 8 16; -fx-background-color: #F3F4F6; -fx-text-fill: #6B7280;" text="Clear" />
                </VBox>
            </HBox>

            <!-- TABLE -->
            <VBox spacing="12" VBox.vgrow="ALWAYS">

                <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1A2332;" text="All Records" />

                <TableView fx:id="recordsTable">

                    <columns>
                            <TableColumn fx:id="patientIdColumn" prefWidth="140" text="Patient ID" />

                            <TableColumn fx:id="patientNameColumn" prefWidth="160" text="Patient Name" />

                            <TableColumn fx:id="scanDateColumn" prefWidth="130" text="Scan Date" />

                            <TableColumn fx:id="scanTypeColumn" prefWidth="120" text="Follow-up" />

                            <TableColumn fx:id="diagnosisColumn" prefWidth="160" text="Criticality Level" />

                            <TableColumn fx:id="actionsColumn" prefWidth="120" sortable="false" text="Actions" />

                    </columns>

                    <placeholder>
                        <VBox alignment="CENTER" spacing="12" style="-fx-padding: 60;">
                            <Label style="-fx-font-size: 48; -fx-text-fill: #D1D5DB;" text="📋" />

                            <Label style="-fx-font-size: 16; -fx-text-fill: #6B7280; -fx-font-weight: bold;" text="No Patient Records Found" />

                            <Label style="-fx-font-size: 12; -fx-text-fill: #9CA3AF;" text="Search by Patient ID or create a new record" />
                        </VBox>
                    </placeholder>

                </TableView>
            </VBox>

        </VBox>
    </center>

    <!-- BOTTOM -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: #F3F4F6; -fx-border-color: #E8EEF5; -fx-border-width: 1 0 0 0;">

            <padding>
                <Insets bottom="12" left="32" right="32" top="12" />
            </padding>

            <!-- 🔥 LOGO ADDED (BOTTOM LEFT) -->
            <Label style="-fx-font-size: 18px;                           -fx-font-weight: bold;                           -fx-text-fill: #111;" text="dAIbetes" />

            <Region HBox.hgrow="ALWAYS" />

            <Label fx:id="statusBarLabel" style="-fx-font-size: 11; -fx-text-fill: #6B7280;" text="Ready" />

            <Label style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;" text="Last updated:" />

            <Label fx:id="lastUpdatedLabel" style="-fx-font-size: 11; -fx-text-fill: #6B7280; -fx-font-weight: bold;" text="--:--" />

        </HBox>
    </bottom>

</BorderPane>
