<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefHeight="900.0" prefWidth="1400.0" spacing="40.0" styleClass="main-container" stylesheets="@../../../../styles/my-patient.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.daibetes.modules.doctor.ui.patients.MyPatientsController">

    <padding>
        <Insets bottom="50.0" left="80.0" right="80.0" top="50.0" />
    </padding>

    <!-- Header & Search -->
    <HBox alignment="CENTER_LEFT" maxWidth="1400.0">
        <VBox spacing="5">
            <Label styleClass="header-title" text="My Patients" style="-fx-font-size: 40px; -fx-font-weight: 800;" />
            <Label text="View and manage your current patient list" style="-fx-text-fill: #64748B; -fx-font-size: 16px;" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <TextField fx:id="searchField" prefHeight="50.0" prefWidth="400.0" promptText="Search patients by name or ID..." styleClass="search-field" />
    </HBox>

    <!-- Filter Pills Row -->
    <HBox alignment="CENTER_LEFT" spacing="20.0" maxWidth="1400.0">
        <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B; -fx-font-size: 14px;" text="SORT BY:" />
        <HBox spacing="15.0">
            <ToggleButton selected="true" styleClass="filter-pill" text="RECENT">
                <toggleGroup><ToggleGroup fx:id="filterGroup" /></toggleGroup>
            </ToggleButton>
            <ToggleButton styleClass="filter-pill" text="OLDEST" toggleGroup="$filterGroup" />
            <ToggleButton styleClass="filter-pill" text="MOST CRITICAL" toggleGroup="$filterGroup" />
            <ToggleButton styleClass="filter-pill" text="LEAST CRITICAL" toggleGroup="$filterGroup" />
        </HBox>
    </HBox>

    <!-- Centered Patient Grid Area -->
    <VBox VBox.vgrow="ALWAYS" alignment="CENTER" style="-fx-background-color: white;">
        <ScrollPane fitToWidth="true" styleClass="grid-scroll" vbarPolicy="NEVER">
            <StackPane> <!-- This ensures the grid stays centered in the scroll area -->
                <GridPane fx:id="patientGrid" hgap="40.0" vgap="40.0" alignment="CENTER">
                    <padding>
                        <Insets top="20" bottom="20" left="20" right="20"/>
                    </padding>
                </GridPane>
            </StackPane>
        </ScrollPane>
    </VBox>

    <!-- Footer Navigation -->
    <HBox alignment="CENTER" maxWidth="1400.0">
        <Button onAction="#handleBack" prefHeight="45.0" prefWidth="120.0" styleClass="back-btn" text="← BACK" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER" spacing="25.0">
            <Button onAction="#handlePrev" prefHeight="45.0" prefWidth="110.0" styleClass="nav-btn" text="PREV" />
            <Label fx:id="paginationLabel" styleClass="pagination-text" text="Page 1 of 2" style="-fx-font-size: 16px;" />
            <Button onAction="#handleNext" prefHeight="45.0" prefWidth="110.0" styleClass="nav-btn" text="NEXT" />
        </HBox>
        <Region HBox.hgrow="ALWAYS" />
        <Region prefWidth="120.0" /> <!-- Spacer to balance the Back button -->
    </HBox>
</VBox>