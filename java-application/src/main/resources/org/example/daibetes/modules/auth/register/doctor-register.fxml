<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.daibetes.modules.auth.register.controller.DoctorRegisterController">

    <!-- The StackPane fills the whole screen and provides the semi-transparent overlay -->
    <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"
               style="-fx-background-color: rgba(0,0,0,0.3);">

        <!--
           FIXED: Added maxHeight="-Infinity" to stop the white box from stretching vertically.
           FIXED: Alignment set to CENTER to match the Login and Patient Register UI.
        -->
        <VBox fx:id="card" alignment="CENTER" maxWidth="620" maxHeight="-Infinity" spacing="15"
              style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 10);">

            <!-- TITLE (Logic and structure unchanged) -->
            <VBox alignment="CENTER" spacing="3">
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Create an Account" />
                <HBox alignment="CENTER" spacing="3">
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #444;" text="You are registering as a" />
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #8B0000;" text="Doctor." />
                </HBox>
            </VBox>

            <!-- FORM: IDs and Actions are preserved exactly -->
            <HBox alignment="TOP_CENTER" spacing="20">

                <!-- LEFT COLUMN -->
                <VBox prefWidth="260" spacing="10">
                    <VBox alignment="CENTER_LEFT" spacing="5">
                        <Label text="License Number:" />
                        <TextField fx:id="doctorIdField" maxWidth="Infinity" style="-fx-background-radius: 8; -fx-background-color: black; -fx-text-fill: white;" />
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="5">
                        <Label text="First Name:" />
                        <TextField fx:id="firstNameField" maxWidth="Infinity" style="-fx-background-radius: 8; -fx-background-color: black; -fx-text-fill: white;" />
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="5">
                        <Label text="Last Name:" />
                        <TextField fx:id="lastNameField" maxWidth="Infinity" style="-fx-background-radius: 8; -fx-background-color: black; -fx-text-fill: white;" />
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="5">
                        <Label text="Email:" />
                        <TextField fx:id="emailField" maxWidth="Infinity" style="-fx-background-radius: 8; -fx-background-color: black; -fx-text-fill: white;" />
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="5">
                        <Label text="Contact No:" />
                        <TextField fx:id="contactField" maxWidth="Infinity" style="-fx-background-radius: 8; -fx-background-color: black; -fx-text-fill: white;" />
                    </VBox>
                </VBox>

                <!-- RIGHT COLUMN -->
                <VBox prefWidth="260" spacing="10">
                    <VBox alignment="CENTER_LEFT" spacing="5">
                        <Label text="Birthdate:" />
                        <DatePicker fx:id="birthdatePicker" maxWidth="Infinity" />
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="5">
                        <Label text="Password:" />
                        <PasswordField fx:id="passwordField" maxWidth="Infinity" style="-fx-background-radius: 8; -fx-background-color: black; -fx-text-fill: white;" />
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="5">
                        <Label text="Confirm Password:" />
                        <PasswordField fx:id="confirmPasswordField" maxWidth="Infinity" style="-fx-background-radius: 8; -fx-background-color: black; -fx-text-fill: white;" />
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="5">
                        <Label text="Gender:" />
                        <HBox fx:id="genderBox" alignment="CENTER_LEFT" spacing="20">
                            <RadioButton fx:id="maleBtn" text="Male" />
                            <RadioButton fx:id="femaleBtn" text="Female" />
                        </HBox>
                    </VBox>
                </VBox>
            </HBox>

            <!-- CREATE ACCOUNT BUTTON (Action preserved) -->
            <Button fx:id="createAccountBtn" onAction="#handleCreateAccount"
                    style="-fx-background-color: #d71919; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 8 25; -fx-cursor: hand;"
                    text="Create Account" />

            <!-- LOGIN LINK (Action preserved) -->
            <HBox alignment="CENTER">
                <Label text="have an account? " />
                <Label onMouseClicked="#goToLogin" style="-fx-text-fill: #8B0000; -fx-font-weight: bold; -fx-cursor: hand;" text="Log-in instead" />
            </HBox>

        </VBox>
    </StackPane>
</AnchorPane>