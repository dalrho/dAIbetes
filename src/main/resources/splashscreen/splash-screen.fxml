<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<AnchorPane
        prefWidth="900"
        prefHeight="600"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="splashscreen.splashController">

    <StackPane prefWidth="900" prefHeight="600" alignment="CENTER">
        <VBox fx:id="rootContainer"
              alignment="CENTER"
              spacing="20"
              maxWidth="500">

            <!-- TITLE -->
            <TextFlow textAlignment="CENTER">

                <Text text="d"
                      style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-fill: black;" />

                <Text text="AI"
                      style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-fill: #9e9e9e;" />

                <Text text="betes"
                      style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-fill: black;" />

            </TextFlow>

            <!-- SUBTITLE -->
            <Label text="Diabetes risk screening and early detection system"
                   wrapText="true"
                   textAlignment="CENTER"
                   style="-fx-font-size: 15px; -fx-text-fill: #666;" />

            <!-- BUTTON -->
            <Button text="Start Now"
                    onAction="#handleStart"
                    style="
                        -fx-background-color: black;
                        -fx-text-fill: white;
                        -fx-padding: 12 30;
                        -fx-background-radius: 12;
                        -fx-font-size: 14px;
                    "/>

        </VBox>

    </StackPane>

</AnchorPane>