<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.daibetes.modules.doctor.ui.DoctorDashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 15; -fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-width: 0 0 1 0;">

            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="My Dashboard" />

            <Label style="-fx-font-style: italic; -fx-text-fill: #666;" text="Welcome back, Dr. Serato!" />

            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#handleLogout" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold;" text="Logout" />
        </HBox>
    </top>

    <left>
        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f1f3f5; -fx-min-width: 200;">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Quick Access" />

            <Separator />

            <Button maxWidth="Infinity" onAction="#handleNewDiagnosis" style="-fx-padding: 10;" text="New Diagnosis" />

            <Button maxWidth="Infinity" onAction="#handleViewRecords" style="-fx-padding: 10;" text="View Patients" />

            <Button maxWidth="Infinity" onAction="#handleReports" style="-fx-padding: 10;" text="Recent Reports" />
         <Button layoutX="30.0" layoutY="192.0" maxWidth="Infinity" onAction="#handleUploadImage" style="-fx-padding: 10;" text="Upload Image" />
        </VBox>
    </left>
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="System Overview" />

            <HBox spacing="20">
                <VBox alignment="CENTER" prefWidth="200" style="-fx-background-color: #e7f5ff; -fx-border-color: #a5d8ff; -fx-padding: 20; -fx-background-radius: 5; -fx-border-radius: 5;">
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #1971c2;" text="Total Scans" />
                    <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="1,284" />
                </VBox>

            </HBox>
            <Separator />
            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="My Recent Activity" />

                <ListView fx:id="recentActivityList" VBox.vgrow="ALWAYS">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="You viewed Patient #23920 January 2026 Report" />
                            <String fx:value="You viewed Patient #23920 December 2026 Report" />
                            <String fx:value="You viewed Patient #23920 March 2026 Report" />
                        </FXCollections>
                    </items>
                </ListView>
            </VBox>
        </VBox>
    </center>
    <bottom>
        <HBox style="-fx-padding: 5; -fx-background-color: #eee;">
            <Label style="-fx-font-size: 10px;" text="System Status: Online" />
        </HBox>
    </bottom>

</BorderPane>
