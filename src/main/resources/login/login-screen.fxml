<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefWidth="900" prefHeight="600"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="login.loginController">

    <StackPane prefWidth="900" prefHeight="600">

        <VBox alignment="TOP_CENTER" spacing="25"
              style="-fx-padding: 70 0 0 0;"
        >

            <!-- LOGO -->
            <VBox alignment="CENTER" spacing="5">

                <TextFlow textAlignment="CENTER">
                    <Text text="d"
                          style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-fill: black;" />
                    <Text text="AI"
                          style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-fill: #9e9e9e;" />
                    <Text text="betes"
                          style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-fill: black;" />
                </TextFlow>

                <Label text="Diabetes risk screening and early detection system"
                       wrapText="true"
                       textAlignment="CENTER"
                       style="-fx-font-size: 15px; -fx-text-fill: #666;" />
            </VBox>

            <!-- CARD -->
            <VBox spacing="15"
                  alignment="CENTER"
                  maxWidth="400"
                  style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15;">

                <Label text="Log-in"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;" />

                <!-- NAME -->
                <VBox alignment="CENTER_LEFT" spacing="5" maxWidth="300">
                    <Label text="Name:"/>
                    <TextField fx:id="nameField"
                               maxWidth="300"
                               style="-fx-background-radius: 8; -fx-background-color: black; -fx-text-fill: white;" />
                </VBox>

                <!-- PASSWORD + FORGOT -->
                <VBox alignment="CENTER_LEFT" spacing="5" maxWidth="300">
                    <Label text="Password:"/>
                    <PasswordField fx:id="passwordField"
                                   maxWidth="300"
                                   style="-fx-background-radius: 8; -fx-background-color: black; -fx-text-fill: white;" />

                    <Label text="forgot password?"
                           maxWidth="Infinity"
                           style="-fx-font-size: 11px; -fx-text-fill: #555;" />
                </VBox>

                <!-- BUTTON -->
                <Button text="Log-in"
                        onAction="#handleLogin"
                        style="-fx-background-color: #d71919; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 8 25;" />

                <!-- REGISTER LINK -->
                <HBox alignment="CENTER">
                    <Label text="don’t have an account? "/>
                    <Label text="Register Now"
                           onMouseClicked="#goToRegister"
                           style="-fx-text-fill: #8B0000; -fx-font-weight: bold;" />
                </HBox>

            </VBox>

        </VBox>
    </StackPane>
</AnchorPane>