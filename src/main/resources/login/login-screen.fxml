<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="login.loginController">
    <children>
        <GridPane hgap="30.0" layoutX="195.0" layoutY="43.0" prefHeight="515.0" prefWidth="510.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="286.0" minWidth="10.0" prefWidth="257.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="255.0" minWidth="10.0" prefWidth="253.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints maxHeight="166.0" minHeight="20.0" prefHeight="20.0" valignment="CENTER" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="414.0" minHeight="20.0" prefHeight="20.0" valignment="CENTER" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="464.0" minHeight="90.0" prefHeight="90.0" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="464.0" minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="464.0" minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="464.0" minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="464.0" minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="464.0" minHeight="50.0" prefHeight="50.0" valignment="BOTTOM" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="464.0" minHeight="30.0" prefHeight="30.0" valignment="CENTER" vgrow="SOMETIMES" />
                <RowConstraints maxHeight="464.0" minHeight="10.0" prefHeight="20.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>

                <!-- Title: dAIbetes -->
                <HBox alignment="CENTER" prefHeight="172.0" prefWidth="371.0" GridPane.columnSpan="2" GridPane.valignment="CENTER">
                    <children>
                        <Label alignment="CENTER" prefHeight="172.0" prefWidth="12.0" style="-fx-text-fill: white;" text="d">
                            <font><Font size="50.0" /></font>
                        </Label>
                        <Label prefHeight="73.0" prefWidth="53.0" style="-fx-font-weight: bold; -fx-text-fill: white;" text="AI">
                            <font><Font size="50.0" /></font>
                        </Label>
                        <Label prefHeight="73.0" prefWidth="120.0" style="-fx-text-fill: white;" text="betes">
                            <font><Font size="50.0" /></font>
                        </Label>
                    </children>
                </HBox>

                <!-- Subtitle -->
                <Label alignment="CENTER" prefHeight="17.0" prefWidth="532.0"
                       text="DIABETES EARLY DETECTION SYSTEM" textFill="#ffffff80"
                       GridPane.columnSpan="2" GridPane.rowIndex="1">
                    <font><Font size="10.0" /></font>
                </Label>

                <!-- Role Toggle Buttons -->
                <ToggleButton fx:id="doctorToggle"
                              mnemonicParsing="false"
                              prefHeight="40.0" prefWidth="264.0"
                              style="-fx-background-color: transparent; -fx-background-radius: 0; -fx-border-color: white; -fx-text-fill: white;"
                              text="DOCTOR"
                              onAction="#onRoleToggled"
                              GridPane.rowIndex="2" />
                <ToggleButton fx:id="patientToggle"
                              mnemonicParsing="false"
                              prefHeight="40.0" prefWidth="238.0"
                              style="-fx-background-radius: 0; -fx-background-color: transparent; -fx-border-color: white;"
                              text="PATIENT" textFill="#ffffff99"
                              onAction="#onRoleToggled"
                              GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <!-- Email Label -->
                <Label prefHeight="17.0" prefWidth="253.0"
                       text="EMAIL ADDRESS" textFill="#ffffff99"
                       GridPane.rowIndex="3" />

                <!-- Email Field -->
                <TextField fx:id="emailtxtfield"
                           prefHeight="40.0"
                           style="-fx-background-color: transparent; -fx-background-radius: 0; -fx-border-color: white; -fx-text-fill: white;"
                           GridPane.columnSpan="2" GridPane.rowIndex="4" />

                <!-- Password Label -->
                <Label prefHeight="17.0" prefWidth="246.0"
                       text="PASSWORD" textFill="#ffffff99"
                       GridPane.rowIndex="5" />

                <!-- Password Field (changed from TextField to PasswordField) -->
                <PasswordField fx:id="passwordField"
                               prefHeight="40.0"
                               style="-fx-background-color: transparent; -fx-background-radius: 0; -fx-border-color: white; -fx-text-fill: white;"
                               GridPane.columnSpan="2" GridPane.rowIndex="6" />

                <!-- Sign In Button -->
                <Button fx:id="loginButton"
                        mnemonicParsing="false"
                        prefHeight="40.0" prefWidth="528.0"
                        style="-fx-background-color: white; -fx-background-radius: 0;"
                        text="SIGN IN"
                        onAction="#onLoginButtonClicked"
                        GridPane.columnSpan="2" GridPane.rowIndex="7">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Button>

                <!-- Error label (row 8, replaces Forgot Password) -->
                <Label fx:id="errorLabel"
                       alignment="TOP_LEFT"
                       prefHeight="17.0" prefWidth="257.0"
                       text="" textFill="#ff6b6b"
                       GridPane.rowIndex="8" />

                <!-- Register Row -->
                <HBox alignment="CENTER" prefHeight="106.0" prefWidth="237.0"
                      GridPane.columnSpan="2" GridPane.rowIndex="9">
                    <children>
                        <Label alignment="CENTER" prefHeight="106.0" prefWidth="126.0"
                               text="Don't have an account?" textFill="#ffffff80" />
                        <Label fx:id="registerLabel"
                               alignment="CENTER" prefHeight="106.0" prefWidth="49.0"
                               text="Register" textFill="WHITE"
                               onMouseClicked="#onRegisterClicked"
                               style="-fx-cursor: hand;" />
                    </children>
                </HBox>

            </children>
        </GridPane>
    </children>
</AnchorPane>
