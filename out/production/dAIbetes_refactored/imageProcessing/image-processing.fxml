<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #ECEFF1;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.daibetes.modules.detection.ui.ImageProcessingController">
    <children>
        <!-- 1. Header Navigation Bar -->
        <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="15.0" style="-fx-background-color: #263238; -fx-padding: 0 20 0 20;">
            <children>
                <Button onAction="#handleBackToGallery" style="-fx-background-color: #546E7A; -fx-text-fill: white;" text="← BACK TO GALLERY" />
                <Separator orientation="VERTICAL" prefHeight="20.0" />
                <Label text="DIAGNOSTIC IMAGE ENHANCEMENT" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleReset" style="-fx-background-color: #CFD8DC;" text="RESET FILTERS" />
            </children>
        </HBox>

        <!-- 2. Main Workspace (Comparison Panes) -->
        <HBox spacing="10.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <!-- Left Pane: Original -->
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="ORIGINAL (RAW)" textFill="#546E7A" />
                        <ScrollPane fx:id="rawScroll" pannable="true" style="-fx-background: #000000; -fx-border-color: #B0BEC5;" VBox.vgrow="ALWAYS">
                            <content>
                                <StackPane>
                                    <children>
                                        <Group>
                                            <children>
                                                <ImageView fx:id="rawImageView" fitWidth="400.0" preserveRatio="true" />
                                            </children>
                                        </Group>
                                    </children>
                                </StackPane>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>

                <!-- Right Pane: Enhanced -->
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="ENHANCED PREVIEW" textFill="#1976D2" />
                        <HBox spacing="10.0" VBox.vgrow="ALWAYS">
                            <children>
                                <ScrollPane fx:id="enhancedScroll" pannable="true" style="-fx-background: #000000; -fx-border-color: #B0BEC5;" HBox.hgrow="ALWAYS">
                                    <content>
                                        <StackPane>
                                            <children>
                                                <Group>
                                                    <children>
                                                        <ImageView fx:id="enhancedImageView" fitWidth="400.0" preserveRatio="true" />
                                                    </children>
                                                </Group>
                                            </children>
                                        </StackPane>
                                    </content>
                                </ScrollPane>
                                <!-- Vertical Zoom Slider -->
                                <VBox alignment="CENTER" spacing="5.0">
                                    <children>
                                        <Label rotate="-90.0" text="ZOOM">
                                            <font>
                                                <Font size="9.0" />
                                            </font>
                                        </Label>
                                        <Slider fx:id="zoomSlider" min="1.0" max="4.0" orientation="VERTICAL" prefHeight="300.0" value="1.0" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- 3. Control Dashboard -->
        <HBox prefHeight="150.0" spacing="20.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CFD8DC transparent transparent transparent; -fx-padding: 15;">
            <children>
                <VBox spacing="10.0">
                    <children>
                        <ToggleButton fx:id="grayscaleToggle" onAction="#updatePreview" prefWidth="140.0" text="GRAYSCALE" />
                        <VBox spacing="2.0">
                            <children>
                                <Label text="Resolution Target">
                                    <font>
                                        <Font size="11.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="resizeCombo" onAction="#updatePreview" prefWidth="140.0" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <Separator orientation="VERTICAL" />

                <GridPane hgap="30.0" vgap="10.0" HBox.hgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                    </columnConstraints>
                    <children>
                        <VBox spacing="2.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <children>
                                <Label text="Brightness" />
                                <Slider fx:id="brightnessSlider" max="0.5" min="-0.5" onMouseReleased="#updatePreview" />
                            </children>
                        </VBox>
                        <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <children>
                                <Label text="Contrast (CLAHE)" />
                                <Slider fx:id="claheSlider" max="3.0" min="0.5" onMouseReleased="#updatePreview" value="1.0" />
                            </children>
                        </VBox>
                        <VBox spacing="2.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <children>
                                <Label text="Edge Sharpness" />
                                <Slider fx:id="sharpSlider" max="10.0" onMouseReleased="#updatePreview" />
                            </children>
                        </VBox>
                        <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <children>
                                <Label text="Noise Reduction" />
                                <Slider fx:id="denoiseSlider" max="1.0" onMouseReleased="#updatePreview" />
                            </children>
                        </VBox>
                    </children>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>

                <Separator orientation="VERTICAL" />

                <!-- AI Detection Section -->
                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button onAction="#handleAIDetection" prefHeight="60.0" prefWidth="170.0" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;" text="RUN AI DETECTION" />
                        <Label text="Detect after processing" textFill="#78909C">
                            <font>
                                <Font size="9.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>